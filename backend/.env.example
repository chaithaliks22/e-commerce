PORT=5000
# Set your MongoDB connection string (Local MongoDB or MongoDB Atlas):
# Example: mongodb://127.0.0.1:27017/mini_ecommerce
# Or Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mini_ecommerce?retryWrites=true&w=majority
# If left empty, the server automatically starts an in-memory MongoDB instance for development!
MONGO_URI=mongodb://127.0.0.1:27017/mini_ecommerce
JWT_SECRET=your_super_secret_jwt_key_here
NODE_ENV=development
